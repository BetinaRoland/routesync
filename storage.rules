rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function activeRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }
    function activeUser() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function isAdmin() {
      return activeUser() && activeRole() in ['routeAdmin', 'superAdmin'];
    }
    function isRouteAdmin() {
      return activeUser() && activeRole() == 'routeAdmin';
    }
    match /expenses/{expenseId}/{fileName} {
      allow read: if isAdmin();
      allow create: if isRouteAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'application/pdf'];
      allow update, delete: if false;
    }
  }
}
